# Cấu hình Môi trường Server Halios (KHÔNG COMMIT FILE .env THỰC TẾ LÊN GIT)
PORT=3000
NODE_ENV=production

# Khóa bí mật ký Session / Token (Tạo chuỗi ngẫu nhiên dài >= 32 ký tự)
SESSION_SECRET=halios_super_secret_session_key_replace_this_with_random_string_2026

# URL Firebase Database (Được bảo mật hoàn toàn ở Backend, không lộ ra Client)
FIREBASE_DB_URL=https://halisos-default-rtdb.asia-southeast1.firebasedatabase.app
